# 连接器生产环境变量模板（复制为 /etc/kbai/connector.env，chmod 600，勿入库）
# 必填
CONNECTOR_PUBLIC_URL=https://kb.example.com
# 隐私页运营主体 / 联系邮箱（上线必须替换默认占位）
CONNECTOR_OPERATOR=XX 科技有限公司
CONNECTOR_PRIVACY_CONTACT=privacy@example.com

# 监听（默认 0.0.0.0:8000；由反向代理转发到内网地址）
# CONNECTOR_HOST=127.0.0.1
# CONNECTOR_PORT=8000

# OAuth 状态文件：单实例指向持久盘；多实例必须共享存储（见 docs/部署与上线.md §5）
CONNECTOR_OAUTH_STATE=data/oauth_state.json

# 审计日志受管目录（自动 0600 + 按容量轮转保留）
AUDIT_FILE=/var/log/kbai/audit.jsonl
# AUDIT_MAX_BYTES=5242880
# AUDIT_BACKUPS=3

# 工具调用硬超时（平台要求 ≤30s）
# CONNECTOR_MAX_CALL_SECONDS=30

# 应用层 HTTPS（若反向代理终止 TLS 则保留注释）
# CONNECTOR_TLS_CERT=/etc/letsencrypt/live/kb.example.com/fullchain.pem
# CONNECTOR_TLS_KEY=/etc/letsencrypt/live/kb.example.com/privkey.pem

# 隐私政策终稿（法务 HTML；缺省用内置模板）
# CONNECTOR_PRIVACY_FILE=/opt/kbai/privacy-final.html

# 本地模型（数据驻留：LLM_FALLBACK_URLS 必须保持为空）
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# LLM_FALLBACK_URLS=

# 备份（工具自行按 os 值可用时生效）
# BACKUP_DIR=/var/backups/kbai
# BACKUP_KEEP=14